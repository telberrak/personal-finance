{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadMizanSettings",
      "Effect": "Allow",
      "Action": ["ssm:GetParametersByPath", "ssm:GetParameters", "ssm:GetParameter"],
      "Resource": ["arn:aws:ssm:eu-west-2:*:parameter/mizan", "arn:aws:ssm:eu-west-2:*:parameter/mizan/*"]
    },
    {
      "Sid": "DecryptMizanSettings",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": { "StringEquals": { "kms:ViaService": "ssm.eu-west-2.amazonaws.com" } }
    }
  ]
}
